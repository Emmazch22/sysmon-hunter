# Keep the build context small and the image clean. Everything here is either
# rebuilt inside the image, secret, or irrelevant to running the engine.

# Python artefacts
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local state -- the container gets its own database on a volume
data/
*.db
*.sqlite3

# Secrets and local config
.env

# Development-only
.git/
.gitignore
.vscode/
tests/
pytest.ini
*.md
!README.md

# OS noise
.DS_Store
Thumbs.db