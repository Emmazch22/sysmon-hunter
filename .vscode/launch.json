{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run engine",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Replay telemetry",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/replay_evtx.py",
            "args": [
                "--file",
                "tests/fixtures/sample.jsonl"
            ],
            "console": "integratedTerminal"
        }
    ]
}